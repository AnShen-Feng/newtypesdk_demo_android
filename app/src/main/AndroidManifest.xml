<!-- newtypesdk_android/app/src/main/AndroidManifest.xml -->
<!-- ============================================================================
     Android 应用清单文件（Android Manifest）
     ============================================================================
     此文件是 Android 应用的核心配置文件，用于声明：
     1. 应用所需的权限（网络、麦克风等）
     2. 应用组件（Activity、Service、BroadcastReceiver 等）
     3. 应用的全局配置和元数据
     ============================================================================ -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================================================================
         权限声明
         ======================================================================== -->
    <!-- 网络权限：允许应用访问网络，用于与 NewType SDK 后端通信 -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- 录音权限：允许应用使用麦克风录制音频
         这是危险权限（Dangerous Permission），需要在运行时请求用户授权
         NewType SDK 需要此权限进行语音输入和实时对话 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ========================================================================
         应用组件声明
         ======================================================================== -->
    <application
        <!-- 允许备份：允许应用数据通过 Google Backup 进行备份和恢复 -->
        android:allowBackup="true"
        
        <!-- 应用图标：定义应用在主屏幕和任务管理器中显示的图标 -->
        android:icon="@mipmap/ic_launcher"
        
        <!-- 应用名称：从 strings.xml 资源文件引用应用显示名称 -->
        android:label="@string/app_name"
        
        <!-- 圆形图标：用于 Android 7.0+ 的圆形启动器图标 -->
        android:roundIcon="@mipmap/ic_launcher_round"
        
        <!-- 支持 RTL：允许应用支持从右到左的语言（如阿拉伯语、希伯来语） -->
        android:supportsRtl="true"
        
        <!-- 应用主题：设置全局应用主题为 NewTypeSdkDemo 主题 -->
        android:theme="@style/Theme.NewTypeSdkDemo">
        
        <!-- ====================================================================
             Activity 声明
             ==================================================================== -->
        <!-- MainActivity - 应用的主入口 Activity -->
        <activity
            android:name=".MainActivity"
            <!-- 导出为 true：允许其他应用或系统启动此 Activity -->
            android:exported="true">
            
            <!-- 意图过滤器：定义此 Activity 如何被启动 -->
            <intent-filter>
                <!-- 主动作：表示这是应用的主要入口点 -->
                <action android:name="android.intent.action.MAIN" />
                
                <!-- 启动器类别：表示此 Activity 应显示在应用启动器中 -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
